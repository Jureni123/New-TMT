<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0f0f1a">

    <!-- ZONA 1: WEBVIEW OFAID BRIDGE -->
    <WebView
        android:id="@+id/ofaid_bridge_webview"
        android:layout_width="match_parent"
        android:layout_height="320dp" 
        android:background="#1565C0" />

    <!-- ZONA 2: NATIVE TEAMTALK UI -->
    <LinearLayout
        android:id="@+id/original_tt_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#121212">

        <!-- Status Bar Mini -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1e1e24"
            android:padding="6dp"
            android:gravity="center_vertical">
            <TextView android:id="@+id/connectionstat_textview" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#aaa"/>
            <TextView android:id="@+id/pingstat_textview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#aaa" android:layout_marginHorizontal="8dp"/>
            <TextView android:id="@+id/totalstat_textview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#aaa"/>
        </LinearLayout>

        <!-- Tab Layout -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#1e1e24"
            app:tabIndicatorHeight="0dp"
            app:tabTextColor="#aaa"
            app:tabSelectedTextColor="#fff" />

        <!-- ViewPager (List User Native) -->
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#121212" />

        <!-- AREA KONTROL AUDIO (INI YANG HILANG SEHINGGA ERROR) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1a1a1a"
            android:padding="8dp">

            <!-- Baris Kontrol Suara -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Kiri: Mic Gain & VOX -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:id="@+id/miclevel_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#aaa"/>
                    <SeekBar android:id="@+id/mic_gainSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <ImageButton android:id="@+id/voxSwitch" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/mic_green" android:background="?attr/selectableItemBackgroundBorderless"/>
                </LinearLayout>

                <!-- Tengah: Tombol PTT (Transmit Voice) -->
                <Button
                    android:id="@+id/transmit_voice"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="8dp"
                    android:backgroundTint="@android:color/holo_red_light"
                    android:text="PUSH-TO-TALK"
                    android:textColor="#fff"
                    android:textStyle="bold"/>

                <!-- Kanan: Master Volume & Speaker -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:id="@+id/vollevel_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#aaa"/>
                    <SeekBar android:id="@+id/master_volSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <ImageButton android:id="@+id/speakerBtn" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/speaker_blue" android:background="?attr/selectableItemBackgroundBorderless"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Baris Tombol Aksi Tambahan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp">
                <Button android:id="@+id/btn_settings_shortcut" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:text="Set" android:backgroundTint="#757575" android:textColor="#fff" android:layout_marginEnd="2dp"/>
                <Button android:id="@+id/btn_files_shortcut" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:text="File" android:backgroundTint="#757575" android:textColor="#fff" android:layout_marginStart="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
