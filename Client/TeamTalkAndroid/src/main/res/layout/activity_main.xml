<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0f0f1a">

    <!-- ZONA 1: WEBVIEW OFAID BRIDGE (Hanya Header & Avatar Besar) -->
    <WebView
        android:id="@+id/ofaid_bridge_webview"
        android:layout_width="match_parent"
        android:layout_height="320dp" 
        android:background="#1565C0" />

    <!-- ZONA 2: NATIVE TEAMTALK UI (Tab, List User, Kontrol) -->
    <!-- Kita bungkus UI asli agar tidak tertutup WebView -->
    <LinearLayout
        android:id="@+id/original_tt_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#121212">

        <!-- Status Bar Mini (Opsional, bisa disembunyikan jika mau full OFAID look) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1e1e24"
            android:padding="6dp"
            android:gravity="center_vertical">
            <TextView android:id="@+id/connectionstat_textview" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#aaa"/>
            <TextView android:id="@+id/pingstat_textview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#aaa" android:layout_marginHorizontal="8dp"/>
            <TextView android:id="@+id/totalstat_textview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#aaa"/>
        </LinearLayout>

        <!-- TAB LAYOUT (Untuk pindah Channels/Chat/Media/Files) -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#1e1e24"
            app:tabIndicatorHeight="0dp"
            app:tabTextColor="#aaa"
            app:tabSelectedTextColor="#fff"
            app:tabMode="fixed" />

        <!-- VIEWPAGER: Tempat ChannelListAdapter (item_user.xml) dirender -->
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#121212" />

        <!-- AREA KONTROL BAWAH (PTT Native, Mic, Speaker) -->
        <include layout="@layout/layout_controls_native" /> 
        <!-- Catatan: Sebaiknya pindahkan kontrol bawah ke file terpisah agar XML main rapi -->
    </LinearLayout>

</LinearLayout>
