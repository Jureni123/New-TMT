<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1565C0" 
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <!-- Logo Channel (ID ASLI DIPERTAHANKAN) -->
    <ImageView
        android:id="@+id/channelicon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="12dp"
        android:src="@drawable/back_orange" 
        android:importantForAccessibility="no" />

    <!-- Judul Utama (ID ASLI DIPERTAHANKAN) -->
    <TextView
        android:id="@+id/parentname" 
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/channelicon"
        android:layout_centerHorizontal="true"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center" />

    <!-- Topic (ID ASLI DIPERTAHANKAN) -->
    <TextView
        android:id="@+id/chantopic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/parentname"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="14sp"
        android:textColor="#B3FFFFFF" 
        android:gravity="center" />

    <!-- Population (ID ASLI TETAP ADA, HANYA DIGONE AGAR TIDAK ERROR DI JAVA) -->
    <TextView
        android:id="@+id/population"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</RelativeLayout>
